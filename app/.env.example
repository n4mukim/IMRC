# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never import it in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the site (used in auth e-mail redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Step 2: Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Step 4: e-mail via Resend
RESEND_API_KEY=
EMAIL_FROM="IMRC <blog@culturalresilience.org>"
